# =============================================================================
# TrueTone Server & PostgreSQL Configuration
# =============================================================================

# Gemini AI API Key (Required for live Gemini 2.5 Flash scanning)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Individual PostgreSQL Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TrueTone
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative Single Connection URI (takes precedence if set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/TrueTone

# High-Performance Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# SSL Configuration for Cloud Databases (AWS RDS, Neon, Supabase)
# Set to 'true' in production with cloud-hosted PostgreSQL
DB_SSL=false

{
  "name": "truetone-platform",
  "version": "1.0.0",
  "description": "TrueTone - Production-ready high-performance PostgreSQL backend and modular UI for brand tone governance",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/init.js --migrate",
    "db:seed": "node src/db/init.js --seed",
    "db:setup": "node src/db/init.js --setup",
    "test": "node test/db-test.js && node test/publish-flow-test.js"
  },
  "keywords": [
    "postgresql",
    "pg",
    "express",
    "brand-tone",
    "high-performance",
    "gin-index"
  ],
  "author": "TrueTone Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.4"
  }
}

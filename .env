# =============================================================================
# TrueTone Server & PostgreSQL Configuration (Local Development)
# =============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TrueTone
DB_USER=postgres
DB_PASSWORD=postgres

# Pool Configuration
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

DB_SSL=false
